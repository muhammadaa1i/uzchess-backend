# Postgres connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/uzchess
# "true" forces SSL, "false" disables it; if unset, SSL is on when NODE_ENV=production
DATABASE_SSL=
# "true" verifies the DB server's TLS cert against known CAs; defaults to "false" (no verification) to match
# managed-Postgres providers that use self-signed certs. Only set to "true" if your provider supports it.
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

NODE_ENV=development
PORT=8000
# Public base URL of this API, used to build certificate verification QR codes
APP_URL=http://localhost:8000

# HTTP Basic Auth credentials gating the /swagger/* docs when NODE_ENV=production.
# If either is unset in production, Swagger docs are not mounted at all.
SWAGGER_USER=
SWAGGER_PASSWORD=

# Signs/verifies auth JWTs
JWT_SECRET=

# Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Outbound email (profile verification/change flows)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
