# Postgres connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/uzchess
# "true" forces SSL, "false" disables it; if unset, SSL is on when NODE_ENV=production
DATABASE_SSL=
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

NODE_ENV=development
PORT=8000
# Public base URL of this API, used to build certificate verification QR codes
APP_URL=http://localhost:8000

# Signs/verifies auth JWTs
JWT_SECRET=

# Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Outbound email (profile verification/change flows)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
