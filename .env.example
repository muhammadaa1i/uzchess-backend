# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Postgres connection string. Required.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uzchess

# Optional DB connection tuning — all have sensible defaults, uncomment to override.
# DATABASE_SSL=true                        # force SSL on/off; defaults to on when NODE_ENV=production
# DATABASE_POOL_SIZE=10
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Signs/verifies access & refresh JWTs. Required — use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# HTTP port. Optional, defaults to 8000.
PORT=8000

# production | development. Controls DB SSL, SQL query logging, etc. Optional, defaults to development behavior.
NODE_ENV=development

# Public base URL of this API, used to build links (e.g. certificate verification QR codes).
# Optional, defaults to http://localhost:8000.
APP_URL=http://localhost:8000

# Cloudflare R2 object storage — required for any file upload endpoint (book covers, lesson videos, etc).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# SMTP — required for the profile email-verification/change flows.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
